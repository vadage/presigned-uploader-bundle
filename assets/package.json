{
    "name": "@vadage/presigned-uploader-bundle",
    "description": "Stimulus controller for direct-to-storage presigned uploads",
    "version": "0.2.0",
    "license": "MIT",
    "type": "module",
    "main": "dist/upload_controller.js",
    "types": "types/upload_controller.d.ts",
    "exports": {
        ".": {
            "types": "./types/upload_controller.d.ts",
            "default": "./dist/upload_controller.js"
        },
        "./client": {
            "types": "./types/client.d.ts",
            "default": "./dist/client.js"
        },
        "./client.js": {
            "types": "./types/client.d.ts",
            "default": "./dist/client.js"
        }
    },
    "files": [
        "dist",
        "types"
    ],
    "symfony": {
        "controllers": {
            "upload": {
                "main": "dist/upload_controller.js",
                "webpackMode": "eager",
                "fetch": "lazy",
                "enabled": true
            }
        },
        "importmap": {
            "@hotwired/stimulus": "^3.0.0"
        }
    },
    "peerDependencies": {
        "@hotwired/stimulus": "^3.0.0"
    },
    "devDependencies": {
        "@hotwired/stimulus": "^3.2.2",
        "jsdom": "^30.1.2",
        "typescript": "^7.0.2",
        "vitest": "^5.0.3"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json",
        "test": "vitest run"
    }
}
